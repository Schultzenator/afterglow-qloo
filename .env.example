# No keys needed for the demo. Qloo credentials stay on the server.
QLOO_API_KEY=
QLOO_API_URL=https://api.qloo.com
# Optional real model-directed tool calling. Without this, the rule-based planner runs.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
PORT=4317
# For a separate API deployment, set a public HTTPS origin at build time:
# VITE_API_URL=https://afterglow-qloo.your-subdomain.workers.dev
